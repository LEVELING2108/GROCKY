# Debug Dockerfile to check what files are copied
FROM node:18-alpine AS build
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# DEBUG: List all files to see what was copied
RUN echo "=== ROOT DIR ===" && ls -la
RUN echo "=== SRC DIR ===" && ls -la src || echo "src folder NOT FOUND"
RUN echo "=== SERVICES DIR ===" && ls -la src/services || echo "services folder NOT FOUND"
RUN echo "=== CONTEXT DIR ===" && ls -la src/context || echo "context folder NOT FOUND"
RUN echo "=== PAGES DIR ===" && ls -la src/pages || echo "pages folder NOT FOUND"
RUN echo "=== PAGES/ADMIN DIR ===" && ls -la src/pages/admin || echo "pages/admin folder NOT FOUND"

# Build the application
RUN npm run build

# Production stage with Nginx
FROM nginx:alpine
WORKDIR /usr/share/nginx/html

# Remove default nginx static assets
RUN rm -rf ./*

# Copy built assets from build stage
COPY --from=build /app/dist .

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
